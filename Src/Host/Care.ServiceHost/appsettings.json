{
  "ApplicationName": "Salmandan - Elderly Care Platform API",
  "CompanyName": "Salmandan",
  "ContextName": "Care",
  "UseFakeServices": true,

  "ConnectionStrings": {
    "CommandConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Salmandan;Trusted_Connection=True;TrustServerCertificate=True;",
    "QueryConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Salmandan;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "ValidAudience": "SalmandanClient",
    "ValidIssuer": "Salmandan",
    "Secret": "CHANGE_ME_USE_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "TokenExpireMinutes": 60,
    "RefreshExpireMinutes": 43200
  },
  "JWTOptions": {
    "ValidAudience": "SalmandanClient",
    "ValidIssuer": "Salmandan",
    "Secret": "CHANGE_ME_USE_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "TokenExpireMinutes": 60,
    "RefreshExpireMinutes": 43200
  },

  "Sms": {
    "ApiKey": "CHANGE_ME_SMS_API_KEY",
    "LineNumber": 30005000,
    "BaseUrl": "https://api.sms.ir/v1/send/bulk",
    "OtpTemplate": "کد ورود به سامانه سالمندان: {0}\nاین کد تا ۵ دقیقه معتبر است.",
    "Resilience": {
      "MaxRetryAttempts": 2,
      "RetryDelay": "00:00:01",
      "MinimumThroughput": 3,
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:01:00",
      "Timeout": "00:00:10"
    }
  },

  "PaymentGateway": {
    "Provider": "ZarinPal",
    "MerchantId": "CHANGE_ME_MERCHANT_ID",
    "Sandbox": true,
    "CallbackUrl": "https://localhost:7001/api/v1/Orders/Confirm",
    "Resilience": {
      "MaxRetryAttempts": 1,
      "RetryDelay": "00:00:02",
      "MinimumThroughput": 2,
      "FailureRatio": 0.5,
      "SamplingDuration": "00:01:00",
      "BreakDuration": "00:02:00",
      "Timeout": "00:00:15"
    }
  },

  "Swagger": {
    "Title": "Salmandan API",
    "Version": "v1",
    "Description": "پلتفرم مراقبت از سالمندان — اپ خانواده + پنل مؤسسات پرستاری"
  },

  "NHilo": {
    "ConnectionStringId": "CommandConnection",
    "ProviderName": "Microsoft.Data.SqlClient",
    "CreateHiLoStructureIfNotExists": true,
    "DefaultMaxLo": 1,
    "TableName": "HiLoIds",
    "NextHiColumnName": "NextHi",
    "EntityColumnName": "Entity",
    "StorageType": "1",
    "ObjectPrefix": "",
    "Entities": []
  },

  "Redis": {
    "ConnectionString": "localhost:6379"
  },

  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
